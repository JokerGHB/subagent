# ===== 阿里云百炼（DashScope）=====
# 获取: https://bailian.console.aliyun.com → API-KEY 管理
DASHSCOPE_API_KEY=

# ===== Tavily 搜索 =====
# 获取: https://app.tavily.com → 复制 API Key（免费档 1000 次/月）
TAVILY_API_KEY=

# ===== Langfuse 观测（可选）=====
# 云版: 到 https://cloud.langfuse.com 注册拿 public/secret key，
#       HOST 必须填云版地址（默认 localhost:3000 会静默丢 trace）
# 自托管: HOST 填你的地址，如 http://你的服务器:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ===== Redis 缓存（可选，Docker 部署时由 compose 自动注入）=====
# 本地直连时用 redis://localhost:6379/0；Docker 里 compose 会覆盖为 redis://redis:6379/0
# REDIS_URL=redis://localhost:6379/0

# ===== 管理员（可选）=====
# 留空则管理员接口禁用（GET /admin/history 返回 403）。
# 设置后访问管理员接口需带请求头 Authorization: Bearer <值>
ADMIN_TOKEN=your-secret

# ===== 模型分级（可选，默认值见 config/settings.py）=====
# 默认已按角色分好档：高频/串行节点用 flash 求快，关键判断用 max 求稳。
# 想临时换某个角色的模型，取消注释覆盖即可（不填就用 settings.py 里的默认值）。
# 可选模型：qwen3.8-max / qwen3.8-flash / qwen3.8-omni-flash / qwen3.8-2.4t-a95b
#          deepseek-v4.1-flash / deepseek-v4-pro-0813 / kimi-k3 / glm-5.3 / glm-5.3-prime / qwen3.8-27b
# LLM_PLANNER=qwen3.8-flash
# LLM_EXTRACTOR=qwen3.8-flash
# LLM_WRITER=qwen3.8-flash
# LLM_ANALYZER=qwen3.8-max
# LLM_JUDGE=qwen3.8-max
# 单次 LLM 调用超时（秒）：不设的话模型挂起会让任务永远 running、进度条永远卡住
# LLM_TIMEOUT=120

# ===== 思考模式（可选）=====
# 百炼 qwen3.x 默认开启「显式思考」，实测同任务慢 8 倍（13.9 → 114 字符/s），
# 所以默认关闭。设 true 时超时会自动切到下面这个（600s），不必手动改两处。
# LLM_ENABLE_THINKING=false
# LLM_TIMEOUT_THINKING=600
